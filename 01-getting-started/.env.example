# Copy to .env and set the absolute path to your SQLite file.
#
# IMPORTANT: use an absolute path. Lowdefy's dev server runs from inside
# .lowdefy/dev/, so a relative path like "./incidents.sqlite" resolves to
# .lowdefy/dev/incidents.sqlite — SQLite then silently creates an empty file
# there and you get "no such table" errors against a DB you never seeded.
#
# Replace /absolute/path/to below with the real path on your machine.
LOWDEFY_SECRET_SQLITE_FILENAME=/absolute/path/to/tutorial-article/incidents.sqlite
